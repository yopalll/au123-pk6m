APP_NAME=VIYGO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: APP_ENV=production  APP_DEBUG=false  APP_URL=https://viygo.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=viygo-prod
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=                          # Resend API Key — https://resend.com/api-keys
MAIL_FROM_ADDRESS="noreply@viygo.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Midtrans Snap (Sandbox by default; flip MIDTRANS_PRODUCTION=true for live keys).
# Get keys at https://dashboard.sandbox.midtrans.com/settings/config_info
# Production keys at https://dashboard.midtrans.com/settings/config_info
#
# WAJIB dikonfigurasi di Midtrans Dashboard → Settings → Configuration:
#   Payment Notification URL  : https://viygo.id/midtrans/webhook
#   Finish Redirect URL       : https://viygo.id
#   Unfinish Redirect URL     : https://viygo.id
#   Error Redirect URL        : https://viygo.id
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false
# Production: MIDTRANS_PRODUCTION=true (gunakan live server key & client key)
VITE_MIDTRANS_CLIENT_KEY="${MIDTRANS_CLIENT_KEY}"

# Ongkir flat (tanpa API) — gudang VIYGO tersebar di hampir seluruh provinsi.
# Tarif seragam; gratis bila subtotal >= threshold. Boleh dikosongkan (pakai default).
ONGKIR_FLAT_COST=10000
ONGKIR_FREE_THRESHOLD=100000

# Google OAuth (Login / Daftar dengan Google via Socialite)
# Buat OAuth 2.0 Client ID di https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (dev)  : http://127.0.0.1:8000/auth/google/callback
# Authorized redirect URI (prod) : https://viygo.id/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# VIYGO branding / contact
VIYGO_SUPPORT_EMAIL=support@viygo.com
VIYGO_HELP_EMAIL=help@viygo.com
